# Provider selection. Comma-separated; first enabled wins per tier.
LLM_PROVIDERS=local

# Local vLLM (docker-compose.yml)
LLM_LOCAL_BASE_URL=http://localhost:8000
LLM_LOCAL_API_KEY=no-key-required
LLM_LOCAL_DEFAULT_MODEL=Qwen/Qwen2.5-7B-Instruct
LLM_LOCAL_TIMEOUT_S=60
LLM_LOCAL_MAX_RETRIES=3
LLM_LOCAL_ENABLED=true

# Anthropic Claude (enable by adding to LLM_PROVIDERS)
LLM_CLAUDE_BASE_URL=https://api.anthropic.com/v1
LLM_CLAUDE_API_KEY=
LLM_CLAUDE_DEFAULT_MODEL=claude-sonnet-5-20250929
LLM_CLAUDE_ENABLED=false

# OpenAI (enable by adding to LLM_PROVIDERS)
LLM_OPENAI_BASE_URL=https://api.openai.com/v1
LLM_OPENAI_API_KEY=
LLM_OPENAI_DEFAULT_MODEL=gpt-4o
LLM_OPENAI_ENABLED=false

# Audit
LLM_AUDIT_BACKEND=jsonl
LLM_AUDIT_PATH=./audit.jsonl
LLM_AUDIT_INCLUDE_PROMPT=true
LLM_AUDIT_INCLUDE_RESPONSE=true